///|
/// Replay of `examples/vectors-binary16.tsv`, generated by `scripts/float_ref.py`
/// from exact integer arithmetic and cross-checked against numpy (`binary16`)
/// and torch (`bfloat16`) — see the script's `--check` mode.
///
/// The table is the authority here, not the implementation: the rows were fixed
/// before the MoonBit code existed, and a disagreement means the MoonBit side is
/// wrong.

///|
/// Minimal TSV reader. Splitting on `\t` is deliberate — none of the fields in
/// this table can contain a tab, and a general CSV reader would hide a malformed
/// row instead of failing on it.
fn parse_tsv_rows(text : String) -> Array[Array[String]] {
  let rows : Array[Array[String]] = []
  for line in text.split("\n") {
    let l = line.to_owned()
    if l.length() == 0 || l.has_prefix("#") {
      continue
    }
    rows.push(l.split("\t").map(fn(f) { f.to_owned() }).collect())
  }
  rows
}

///|
fn parse_hex_u64(s : String) -> UInt64 {
  let mut acc : UInt64 = 0UL
  for i in 0..<s.length() {
    let c = s.get_char(i).unwrap()
    let d = if c >= '0' && c <= '9' {
      c.to_int() - '0'.to_int()
    } else if c >= 'a' && c <= 'f' {
      c.to_int() - 'a'.to_int() + 10
    } else if c >= 'A' && c <= 'F' {
      c.to_int() - 'A'.to_int() + 10
    } else {
      0
    }
    acc = acc * 16UL + d.to_uint64()
  }
  acc
}

///|
fn rounding_mode_of(name : String) -> RoundingMode {
  match name {
    "nearest_even" => NearestEven
    "nearest_away" => NearestAway
    "toward_zero" => TowardZero
    "toward_positive" => TowardPositive
    "toward_negative" => TowardNegative
    _ => NearestEven
  }
}

///|
test "examples/vectors-binary16.tsv: every binary16 row matches" {
  let text = @fs.read_file_to_string("examples/vectors-binary16.tsv")
  let rows = parse_tsv_rows(text)
  let mut checked = 0
  let mismatches : Array[String] = []
  for row in rows {
    let label = row[4]
    if label.has_prefix("bf16-") {
      continue
    }
    let x = parse_hex_u64(row[0]).reinterpret_as_double()
    let mode = rounding_mode_of(row[1])
    let want = parse_hex_u64(row[2]).to_uint()
    let want_inexact = row[3] == "1"
    let conv = of_f64(x, mode)
    checked = checked + 1
    let got = conv.bits.to_uint()
    if got != want || conv.inexact != want_inexact {
      if mismatches.length() < 10 {
        mismatches.push(
          "\{label}/\{row[1]}: got \{got} inexact=\{conv.inexact}, want \{want} inexact=\{want_inexact}",
        )
      }
    }
  }
  // 830 binary16 rows out of 990: 37 curated cases x 5 modes, plus 200 random
  // nearest-even rows. The count is asserted so a generator that silently drops
  // rows cannot pass unnoticed.
  inspect(checked, content="830")
  inspect(mismatches.length(), content="0")
  for m in mismatches {
    println(m)
  }
}

///|
test "examples/vectors-binary16.tsv: every bfloat16 row matches" {
  let text = @fs.read_file_to_string("examples/vectors-binary16.tsv")
  let rows = parse_tsv_rows(text)
  let mut checked = 0
  let mismatches : Array[String] = []
  for row in rows {
    let label = row[4]
    if not(label.has_prefix("bf16-")) {
      continue
    }
    let f = Float::reinterpret_from_uint(parse_hex_u64(row[0]).to_uint())
    let mode = rounding_mode_of(row[1])
    let want = parse_hex_u64(row[2]).to_uint()
    let want_inexact = row[3] == "1"
    let conv = of_f32(f, mode)
    checked = checked + 1
    let got = conv.bits.to_uint()
    if got != want || conv.inexact != want_inexact {
      if mismatches.length() < 10 {
        mismatches.push(
          "\{label}/\{row[1]}: got \{got} inexact=\{conv.inexact}, want \{want} inexact=\{want_inexact}",
        )
      }
    }
  }
  // 32 bfloat16 cases x 5 modes.
  inspect(checked, content="160")
  inspect(mismatches.length(), content="0")
  for m in mismatches {
    println(m)
  }
}
