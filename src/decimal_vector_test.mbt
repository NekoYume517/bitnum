///|
/// Replay of `examples/vectors-decimal.tsv`: 568 rows from the official IBM/IEEE
/// `dectest` encode suites (`dsEncode`, `ddEncode`, `dqEncode`), generated by
/// `scripts/decimal_ref.py`.
///
/// That script is verified independently against the full `dectest` corpus — run
/// `python scripts/decimal_ref.py` and it prints:
///
///   decimal32    dsEncode.decTest   exact= 123 noncanonical= 24 fail=  0
///   decimal64    ddEncode.decTest   exact= 189 noncanonical= 24 fail=  0
///   decimal128   dqEncode.decTest   exact= 184 noncanonical= 24 fail=  0
///   DPD triple round-trip failures: 0 / 1000
///
/// So the table is authority, not a snapshot of this implementation. Two thirds of
/// the rows are exact encodings and one third are the 24 non-canonical codes per
/// format, which must decode to the documented 8/9 sequence rather than be
/// rejected (PLAN.md §4.4).

///|
fn decimal_format_of(name : String) -> DecimalFormat {
  match name {
    "decimal32" => Decimal32
    "decimal64" => Decimal64
    _ => Decimal128
  }
}

///|
test "vectors-decimal: geometry table is self-consistent" {
  // Before trusting any row, confirm the three constants each format is built
  // from agree with every derived quantity (Emax, Emin, Etiny, group counts).
  let f32 : DecimalFormat = Decimal32
  let f64 : DecimalFormat = Decimal64
  let f128 : DecimalFormat = Decimal128
  inspect(f32.geometry_is_consistent(), content="true")
  inspect(f64.geometry_is_consistent(), content="true")
  inspect(f128.geometry_is_consistent(), content="true")
  inspect(f32.digits(), content="7")
  inspect(f64.digits(), content="16")
  inspect(f128.digits(), content="34")
  inspect(f32.bias(), content="101")
  inspect(f64.bias(), content="398")
  inspect(f128.bias(), content="6176")
  inspect(f32.coef_cont_bits(), content="20")
  inspect(f64.coef_cont_bits(), content="50")
  inspect(f128.coef_cont_bits(), content="110")
}

///|
test "vectors-decimal: all 568 rows decode to the recorded triple" {
  let text = @fs.read_file_to_string("examples/vectors-decimal.tsv")
  let rows = parse_tsv_rows(text)
  inspect(rows.length(), content="568")
  let mismatches : Array[String] = []
  let mut redundant_rows = 0
  let mut exact_rows = 0
  for row in rows {
    let fmt = decimal_format_of(row[0])
    let hex = row[1]
    let want_neg = row[2] == "1"
    let want_coef = BigInt::from_string(row[3], radix=10)
    let want_exp = parse_int_checked(row[4])
    let raw = fmt.from_hex(hex)
    let got = fmt.decode_raw(raw)
    let v = got.value
    let mut ok = v.negative == want_neg
    if ok && v.kind != DFinite {
      ok = false
    }
    if ok && not(v.coefficient.equal(want_coef)) {
      ok = false
    }
    if ok && v.exponent != want_exp {
      ok = false
    }
    if got.redundant_groups > 0 {
      redundant_rows = redundant_rows + 1
    } else {
      exact_rows = exact_rows + 1
    }
    if not(ok) {
      if mismatches.length() < 10 {
        mismatches.push(
          "\{row[0]} \{hex}: got neg=\{v.negative} coef=\{v.coefficient} exp=\{v.exponent}, want neg=\{want_neg} coef=\{row[3]} exp=\{want_exp}",
        )
      }
    }
  }
  inspect(mismatches.length(), content="0")
  for m in mismatches {
    println(m)
  }
  // 568 rows = 496 exact + 72 non-canonical (24 per format).
  inspect(redundant_rows, content="72")
  inspect(exact_rows, content="496")
}

///|
test "vectors-decimal: encode reproduces the exact hex for every canonical row" {
  // For a row whose DPD groups are all canonical, encoding the recorded triple must
  // reproduce the recorded bytes exactly. Non-canonical rows are excluded *by
  // measurement*, not by assumption: the encoder can never emit a redundant code,
  // so requiring it to reproduce one would be requiring it to be wrong
  // (PLAN.md §4.4).
  let text = @fs.read_file_to_string("examples/vectors-decimal.tsv")
  let rows = parse_tsv_rows(text)
  let mismatches : Array[String] = []
  let mut checked = 0
  for row in rows {
    let fmt = decimal_format_of(row[0])
    let hex = row[1]
    let raw = fmt.from_hex(hex)
    let decoded = fmt.decode_raw(raw)
    if decoded.redundant_groups > 0 {
      continue
    }
    let back = fmt.encode_raw(decoded.value)
    checked = checked + 1
    let got_hex = fmt.to_hex(back)
    if got_hex != hex {
      if mismatches.length() < 10 {
        mismatches.push(
          "\{row[0]} \{hex}: re-encoded as \{got_hex} (coef=\{decoded.value.coefficient} exp=\{decoded.value.exponent} neg=\{decoded.value.negative})",
        )
      }
    }
  }
  for m in mismatches {
    println(m)
  }
  inspect(mismatches.length(), content="0")
  inspect(checked, content="496")
}

///|
test "vectors-decimal: the 72 non-canonical rows decode to their 8/9 digit sequence" {
  // Each non-canonical row must (a) be flagged as carrying a redundant group, and
  // (b) still produce the coefficient the reference recorded — which for a
  // redundant code means a run of 8s and 9s. Asserting only the flag would let a
  // decoder that substituted zeros pass.
  let text = @fs.read_file_to_string("examples/vectors-decimal.tsv")
  let rows = parse_tsv_rows(text)
  let failures : Array[String] = []
  let mut count = 0
  for row in rows {
    let fmt = decimal_format_of(row[0])
    let hex = row[1]
    let raw = fmt.from_hex(hex)
    let decoded = fmt.decode_raw(raw)
    if decoded.redundant_groups == 0 {
      continue
    }
    count = count + 1
    let want_coef = BigInt::from_string(row[3], radix=10)
    let got_coef = decoded.value.coefficient
    if not(got_coef.equal(want_coef)) {
      if failures.length() < 10 {
        failures.push(
          "\{row[0]} \{hex}: coefficient \{got_coef}, want \{want_coef}",
        )
      }
    }
  }
  inspect(count, content="72")
  inspect(failures.length(), content="0")
  for f in failures {
    println(f)
  }
}

///|
/// Parse an Int that may carry a leading `-`; the TSV's exponent column always
/// does when negative. Hand-rolled so the test helper has no hidden dependency on a
/// library's error behaviour.
fn parse_int_checked(text : String) -> Int32 {
  let mut i = 0
  let mut neg = false
  if text.length() > 0 && text.get_char(0).unwrap() == '-' {
    neg = true
    i = 1
  }
  let mut acc = 0
  while i < text.length() {
    let c = text.get_char(i).unwrap()
    acc = acc * 10 + (c.to_int() - '0'.to_int())
    i = i + 1
  }
  if neg {
    -acc
  } else {
    acc
  }
}
